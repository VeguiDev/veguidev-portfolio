---
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar";
import Layout from "../../layouts/Layout.astro";

import { Content } from "../docs/postsmaster-eng.md";
---

<Layout title={`VeguiDev - Postmasters}`}>
  <NavBar client:load />
  <main>
    <article class="prose prose-neutral prose-invert max-w-3xl mx-auto py-4">
      <Content />
    </article>
  </main>
  <Footer />

  <style>
    main {
      min-height: 100vh;
    }
    h1 {
      font-size: 3rem;
      font-weight: 800;
      margin: 0;
    }
  </style>
</Layout>
