---
import { changeLanguage, t } from "i18next";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar";
import ProyectCard from "../../components/ProyectCard.astro";
import { translateProjects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";
changeLanguage("en");
const proyectos = translateProjects(t);
---

<Layout title="VeguiDev - Projects">
  <NavBar client:load />
  <section>
    <h2 class="text-4xl font-bold text-center my-12">
      {t("projects")}
    </h2>
    <div class="relative my-12 mx-4">
      <!-- Divider -->
      <hr class="w-full border-neutral-700" />
      <div class="absolute w-full h-96 top-0 bg-gradient"></div>
    </div>

    <!-- Articles -->

    <section class="grid md:grid-cols-3 gap-5 w-[95%] mx-auto mb-12">
      {
        proyectos.map((proyecto) => {
          return (
            <>
              <ProyectCard
                image={proyecto.image}
                title={proyecto.title}
                link={proyecto.link}
                pills={proyecto.pills}
              >
                {proyecto.description}
              </ProyectCard>
            </>
          );
        })
      }
    </section>
  </section>
  <section class="mb-12">
    <h2 class="text-4xl font-bold text-center my-12">{t("be_interested")}</h2>
    <ul class="flex flex-col items-center text-2xl gap-5">
      <li>
        <a
          class="text-blue-brand hover:underline"
          href={t("homeArticle.skills.href")}>{t("homeArticle.skills.title")}</a
        >
      </li>
      <li>
        <a
          class="text-blue-brand hover:underline"
          href={t("homeArticle.formation.href")}
          >{t("homeArticle.formation.title")}</a
        >
      </li>
      <li>
        <a
          class="text-blue-brand hover:underline"
          href={t("homeArticle.info.href")}>{t("aboutMe")}</a
        >
      </li>
    </ul>
  </section>
  <Footer />

  <style>
    main {
      min-height: 100vh;
    }
    h1 {
      font-size: 3rem;
      font-weight: 800;
      margin: 0;
    }
  </style>
</Layout>
