---
import { changeLanguage, t } from "i18next";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar";
import PresentationCard from "../components/PresentationCard.astro";
import Layout from "../layouts/Layout.astro";
import { Info, GraduationCap, FlaskConical, Sparkles } from "lucide-astro";

changeLanguage("es");
---

<Layout title={`VeguiDev - ${t("softwareDeveloper")}`}>
  <main class="text-white">
    <NavBar client:load />
    <section>
      <article
        class="flex flex-col text-xl justify-center items-center my-32 mx-4"
      >
        <span class="w-full h-full overflow-hidden absolute right-0 top-0">
          <img
            src="/degradado2.png"
            class="w-full h-full opacity-10 z-0 saturate-150 rotate-inf -rotate-45"
            alt=""
          />
        </span>
        <div
          class="rounded-full pulse flex justify-center items-center mb-5 w-40 h-40 border-2 border-neutral-700 relative before:absolute before:w-48 before:h-48 before:opacity-70 before:rounded-full before:border before:border-neutral-700 after:absolute after:w-96 after:h-96 after:opacity-20 after:rounded-full after:border after:border-neutral-700/80"
        >
          <img
            src="/foto.png"
            class="w-40 h-40 object-cover rounded-full"
            alt="Juan Manuel Menta foto"
          />
        </div>
        <h3 class="font-bold mt-2">Juan Manuel Menta</h3>
        <h3>veguidev</h3>
        <h2 class="text-2xl font-black mb-2">{t("softwareDeveloper")}</h2>
      </article>
      <div class="relative my-12 mx-4">
        <!-- Divider -->
        <hr class="w-full border-neutral-700" />
        <div class="absolute w-full h-96 top-0 bg-gradient"></div>
      </div>

      <!-- Articles -->

      <section class="grid md:grid-cols-2 gap-5 w-[95%] mx-auto mb-12">
        <PresentationCard
          icon={Info}
          title={t("homeArticle.info.title")}
          link={t("homeArticle.info.href")}
        >
          {t("homeArticle.info.content")}
        </PresentationCard>
        <PresentationCard
          icon={GraduationCap}
          title={t("homeArticle.formation.title")}
          link={t("homeArticle.formation.href")}
        >
          {t("homeArticle.formation.content")}
        </PresentationCard>
        <PresentationCard
          icon={FlaskConical}
          title={t("homeArticle.projects.title")}
          link={t("homeArticle.projects.href")}
        >
          {t("homeArticle.projects.content")}
        </PresentationCard>

        <PresentationCard
          icon={Sparkles}
          title={t("homeArticle.skills.title")}
          link={t("homeArticle.skills.href")}
        >
          {t("homeArticle.skills.content")}
        </PresentationCard>
      </section>
    </section>
    <Footer />
  </main>

  <style>
    main {
      min-height: 100vh;
    }
    h1 {
      font-size: 3rem;
      font-weight: 800;
      margin: 0;
    }
  </style>
</Layout>
